{
  "name": "till-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "electron . --dev",
    "electron:start": "npm run build && electron . --windowed",
    "electron:pack": "npm run build && electron-builder --win --x64",
    "electron:selftest": "electron electron/selftest.cjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.5",
    "@reduxjs/toolkit": "^2.10.1",
    "@sentry/react": "^10.32.1",
    "@tailwindcss/vite": "^4.1.16",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.552.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.66.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.5",
    "react-toastify": "^11.0.5",
    "recharts": "^3.6.0",
    "redux-saga": "^1.4.2",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "baseline-browser-mapping": "^2.9.12",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "fake-indexeddb": "^6.2.8",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.7"
  },
  "main": "electron/main.cjs",
  "description": "Auvren Till: supermarket till web app and Windows desktop shell",
  "author": "Auvren – Till & Ecommerce Solutions",
  "build": {
    "appId": "com.auvren.till",
    "productName": "Auvren Till",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!electron/*.test.ts"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}
